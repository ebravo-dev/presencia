PORT=3100
HOST=0.0.0.0
NODE_ENV=development

UAT_BASE_URL=https://administracionescolar.uat.edu.mx
UAT_HTTP_TIMEOUT_MS=30000
UAT_SESSION_TTL_MINUTES=45

# PostgreSQL del modulo de coordinacion. Codifica caracteres especiales del password en la URL.
DATABASE_URL=postgresql://<usuario>:<password>@<host-postgres>:5432/<base_de_datos>?schema=public
DATABASE_MIGRATION_MAX_ATTEMPTS=10
DATABASE_MIGRATION_RETRY_MS=3000
COORDINATION_JWT_SECRET=development-coordination-jwt-secret-change-me
COORDINATION_WEB_ORIGIN=http://localhost:5173
COORDINATION_COOKIE_SECURE=false
ATTENDANCE_BACKEND_URL=http://localhost:3000
ATTENDANCE_BACKEND_SERVICE_TOKEN=development-internal-service-token-change-me
# Optional absolute path to frontend-coord/dist in production.
COORDINATION_WEB_DIST=

# One-time provisioning command: npm run coordinator:create
# Para varios coordinadores usa un arreglo JSON. No se eliminan usuarios omitidos de la lista.
COORDINATORS_JSON=
COORDINATOR_EMAIL=<correo-del-coordinador>
COORDINATOR_NAME=<nombre-del-coordinador>
COORDINATOR_PASSWORD=

# Solo para el script CLI npm run fetch:horarios.
# No guardes credenciales reales en archivos versionados.
UAT_USER=
UAT_PASS=
UAT_ID_CICLO_ESCOLAR=150
UAT_ID_DES=12
