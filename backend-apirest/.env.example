PORT=3100
HOST=0.0.0.0
NODE_ENV=development
APP_TIME_ZONE=America/Mexico_City

UAT_BASE_URL=https://administracionescolar.uat.edu.mx
UAT_ALUMNOS_BASE_URL=https://alumnossur.uat.edu.mx
UAT_HTTP_TIMEOUT_MS=30000
UAT_ID_CICLO_ESCOLAR=150
UAT_SESSION_TTL_MINUTES=45

# Modo debug de coordinacion:
# fuerza el ciclo anterior 2026-1 y siembra profesores sinteticos despues de iniciar sesion con un profesor real.
PRESENCIA_DEBUG_MODE=false
PRESENCIA_DEBUG_CYCLE_ID=150
PRESENCIA_DEBUG_CYCLE_NAME="2026 - 1 PRIMAVERA"
PRESENCIA_DEBUG_EXTRA_PROFESSORS=4
PRESENCIA_DEBUG_VERBOSE_LOGS=true
# Opcional: personaliza profesores sinteticos. Si se omite, se generan Profesor Debug 01..N.
# PRESENCIA_DEBUG_EXTRA_PROFESSORS_JSON=[{"externalId":"debug-ana","institutionalCode":"DBG01","name":"Ana Debug","email":"ana.debug@example.test"}]

# PostgreSQL del modulo de coordinacion. Codifica caracteres especiales del password en la URL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/presencia_coordination?schema=public

# Seeder opcional de clases compartidas
SEED_PRIMARY_EMAIL=titular.pruebas@uat.edu.mx
SEED_SECONDARY_EMAIL=profesor2.pruebas@uat.edu.mx
SEED_CYCLE_EXTERNAL_ID=150
SEED_CYCLE_NAME="2026 - 1 PRIMAVERA"
DATABASE_MIGRATION_MAX_ATTEMPTS=10
DATABASE_MIGRATION_RETRY_MS=3000
COORDINATION_JWT_SECRET=development-coordination-jwt-secret-change-me
INTERNAL_API_TOKEN=development-internal-service-token-change-me
COORDINATION_WEB_ORIGIN=http://localhost:5173
COORDINATION_COOKIE_SECURE=false
ATTENDANCE_BACKEND_URL=http://localhost:3000
ATTENDANCE_BACKEND_SERVICE_TOKEN=development-internal-service-token-change-me
# Optional absolute path to frontend-coord/dist in production.
COORDINATION_WEB_DIST=

# One-time provisioning command: npm run coordinator:create
# Para varios coordinadores usa un arreglo JSON. No se eliminan usuarios omitidos de la lista.
COORDINATORS_JSON=
COORDINATOR_EMAIL=coordinacion@uat.edu.mx
COORDINATOR_NAME=Coordinacion Academica
COORDINATOR_PASSWORD=

# Solo para el script CLI npm run fetch:horarios.
# No guardes credenciales reales en archivos versionados.
UAT_USER=
UAT_PASS=
UAT_ID_DES=12
