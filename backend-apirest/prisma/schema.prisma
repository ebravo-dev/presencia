generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Coordination {
  id          String   @id @default(cuid())
  externalId  String   @unique
  name        String
  shortName   String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  subjects    Subject[]
  assignments GroupAssignment[]

  @@index([name])
}

model Teacher {
  id                  String    @id @default(cuid())
  externalId          String    @unique
  institutionalCode   String?
  name                String
  email               String?
  lastAuthenticatedAt DateTime
  lastHarvestedAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  assignments GroupAssignment[]
  sharedClassAssignments SharedClassAssignment[] @relation("SharedClassAssignee")

  @@index([name])
  @@index([institutionalCode])
}

model Subject {
  id             String   @id @default(cuid())
  externalId     String   @unique
  code           String?
  name           String
  coordinationId String
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @updatedAt

  coordination Coordination      @relation(fields: [coordinationId], references: [id], onDelete: Restrict)
  assignments  GroupAssignment[]

  @@index([coordinationId, name])
}

model GroupAssignment {
  id                    String   @id @default(cuid())
  externalGroupId       String   @unique
  groupCode             String?
  schoolCycleExternalId String
  schoolCycleName       String?
  classroom             String?
  educationLevel        String?
  period                String?
  schedule              Json?
  rawPayload            Json?
  teacherId             String
  subjectId             String
  coordinationId        String
  firstSeenAt           DateTime @default(now())
  lastSeenAt            DateTime @updatedAt

  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  coordination Coordination @relation(fields: [coordinationId], references: [id], onDelete: Restrict)
  sharedAssignments SharedClassAssignment[]

  @@index([teacherId])
  @@index([subjectId])
  @@index([coordinationId, schoolCycleExternalId])
}

model SharedClassAssignment {
  id                 String    @id @default(cuid())
  sourceAssignmentId String
  assignedTeacherId  String
  schoolCycleYear    Int
  schoolCycleTerm    Int
  active             Boolean   @default(true)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sourceAssignment GroupAssignment @relation(fields: [sourceAssignmentId], references: [id], onDelete: Cascade)
  assignedTeacher  Teacher         @relation("SharedClassAssignee", fields: [assignedTeacherId], references: [id], onDelete: Cascade)

  @@unique([sourceAssignmentId, assignedTeacherId, schoolCycleYear, schoolCycleTerm])
  @@index([assignedTeacherId, schoolCycleYear, schoolCycleTerm, active])
  @@index([sourceAssignmentId])
}

model CoordinatorUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("COORDINATOR")
  disabledAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions CoordinatorSession[]
}

model CoordinatorSession {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user CoordinatorUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AttendanceUploadBatch {
  id               String                      @id @default(cuid())
  ownerUsername    String                      @map("owner_username")
  idempotencyKey   String                      @map("idempotency_key")
  credentialCipher String?                     @map("credential_cipher")
  status           AttendanceUploadBatchStatus @default(PENDING)
  totalRecords     Int                         @map("total_records")
  completedRecords Int                         @default(0) @map("completed_records")
  failedRecords    Int                         @default(0) @map("failed_records")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")
  completedAt      DateTime?                   @map("completed_at")

  jobs AttendanceUploadJob[]

  @@unique([ownerUsername, idempotencyKey])
  @@index([ownerUsername, createdAt])
  @@index([status, createdAt])
  @@map("attendance_upload_batches")
}

model AttendanceUploadJob {
  id             String                    @id @default(cuid())
  batchId        String                    @map("batch_id")
  ownerUsername  String                    @map("owner_username")
  clientRecordId String                    @map("client_record_id")
  idGrupo        Int                       @map("id_grupo")
  fechaInicio    String                    @map("fecha_inicio")
  attendances    Json
  payloadHash    String                    @map("payload_hash")
  status         AttendanceUploadJobStatus @default(PENDING)
  attempts       Int                       @default(0)
  nextAttemptAt  DateTime                  @default(now()) @map("next_attempt_at")
  lockedAt       DateTime?                 @map("locked_at")
  error          String?
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  completedAt    DateTime?                 @map("completed_at")

  batch AttendanceUploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, clientRecordId])
  @@index([ownerUsername, clientRecordId, createdAt])
  @@index([status, nextAttemptAt, createdAt])
  @@map("attendance_upload_jobs")
}

model DomainOutboxEvent {
  id            String    @id
  eventName     String    @map("event_name")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  occurredAt    DateTime  @map("occurred_at")
  publishedAt   DateTime? @map("published_at")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  lockedAt      DateTime? @map("locked_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, nextAttemptAt, createdAt])
  @@index([lockedAt])
  @@map("domain_outbox_events")
}

model ProcessedDomainEvent {
  id          String   @id @default(cuid())
  eventId     String   @map("event_id")
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at")

  @@unique([eventId, consumer])
  @@index([processedAt])
  @@map("processed_domain_events")
}

enum AttendanceUploadBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum AttendanceUploadJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
