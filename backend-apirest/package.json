{
  "name": "presencia-backend-apirest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API REST para consultar horarios y examenes del portal escolar UAT usando cookies ASP.NET.",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "coordinator:create": "tsx src/scripts/create-coordinator.ts",
    "test": "vitest run",
    "fetch:horarios": "tsx src/scripts/fetch-horarios.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "axios": "^1.7.9",
    "axios-cookiejar-support": "^5.0.5",
    "dotenv": "^16.4.7",
    "fastify": "^5.9.0",
    "jsonwebtoken": "^9.0.3",
    "tough-cookie": "^4.1.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "@types/tough-cookie": "^4.0.5",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
