# Dominio/orígenes públicos
CORS_ALLOWED_ORIGINS=https://presencia.example.edu.mx
COORDINATION_WEB_ORIGIN=https://presencia.example.edu.mx
DOKPLOY_NETWORK_NAME=dokploy-network
# Ejemplo de corte reversible por ruta: {"/professors/login":"identity"}
ROUTE_TARGET_OVERRIDES={}

# PostgreSQL. Usa valores aleatorios y URL-encodea las contraseñas en las URLs.
POSTGRES_ADMIN_PASSWORD=replace-with-a-random-admin-password
ATTENDANCE_DB_NAME=presencia_attendance
ATTENDANCE_DB_USER=presencia_attendance
ATTENDANCE_DB_PASSWORD=replace-with-a-random-attendance-password
UAT_DB_NAME=presencia_uat
UAT_DB_USER=presencia_uat
UAT_DB_PASSWORD=replace-with-a-random-uat-password
ATTENDANCE_DATABASE_URL=postgresql://presencia_attendance:replace-with-url-encoded-password@postgres:5432/presencia_attendance?schema=public
UAT_DATABASE_URL=postgresql://presencia_uat:replace-with-url-encoded-password@postgres:5432/presencia_uat?schema=public
IDENTITY_DB_NAME=presencia_identity
IDENTITY_DB_USER=presencia_identity
IDENTITY_DB_PASSWORD=replace-with-a-random-identity-password
IDENTITY_DATABASE_URL=postgresql://presencia_identity:replace-with-url-encoded-password@postgres:5432/presencia_identity?schema=public
ACADEMIC_DB_NAME=presencia_academic
ACADEMIC_DB_USER=presencia_academic
ACADEMIC_DB_PASSWORD=replace-with-a-random-academic-password
ACADEMIC_DATABASE_URL=postgresql://presencia_academic:replace-with-url-encoded-password@postgres:5432/presencia_academic?schema=public
ATTENDANCE_SERVICE_DB_NAME=presencia_attendance_service
ATTENDANCE_SERVICE_DB_USER=presencia_attendance_service
ATTENDANCE_SERVICE_DB_PASSWORD=replace-with-a-random-attendance-service-password
ATTENDANCE_SERVICE_DATABASE_URL=postgresql://presencia_attendance_service:replace-with-url-encoded-password@postgres:5432/presencia_attendance_service?schema=public
COORDINATION_QUERY_DB_NAME=presencia_coordination_query
COORDINATION_QUERY_DB_USER=presencia_coordination_query
COORDINATION_QUERY_DB_PASSWORD=replace-with-a-random-coordination-query-password
COORDINATION_QUERY_DATABASE_URL=postgresql://presencia_coordination_query:replace-with-url-encoded-password@postgres:5432/presencia_coordination_query?schema=public

# Redis y RabbitMQ
REDIS_PASSWORD=replace-with-a-random-redis-password
REDIS_URL=redis://:replace-with-url-encoded-password@redis:6379/0
RABBITMQ_USER=presencia
RABBITMQ_PASSWORD=replace-with-a-random-rabbitmq-password
RABBITMQ_URL=amqp://presencia:replace-with-url-encoded-password@rabbitmq:5672

# Secretos separados; nunca reutilices valores entre campos.
JWT_SECRET=replace-with-at-least-32-random-characters
IDENTITY_JWT_SECRET=replace-with-another-32-random-characters
COORDINATION_JWT_SECRET=replace-with-another-32-random-characters
INTERNAL_API_TOKEN=replace-with-another-32-random-characters
METRICS_TOKEN=replace-with-another-32-random-characters
IDENTITY_METRICS_TOKEN=replace-with-another-32-random-characters
ACADEMIC_METRICS_TOKEN=replace-with-another-32-random-characters
ATTENDANCE_METRICS_TOKEN=replace-with-another-32-random-characters
COORDINATION_QUERY_METRICS_TOKEN=replace-with-another-32-random-characters
COORDINATION_QUERY_RECONCILE_INTERVAL_MS=300000
BINDING_JWT_SECRET=replace-with-another-32-random-characters
ATTENDANCE_JOB_ENCRYPTION_SECRET=replace-with-another-32-random-characters
UAT_SESSION_ENCRYPTION_SECRET=replace-with-another-32-random-characters
SUPER_USER_PASSWORD=replace-with-a-strong-password
RSA_PRIVATE_KEY=base64-encoded-rsa-private-key

# Aprovisionamiento inicial opcional
COORDINATOR_EMAIL=coordinacion@uat.edu.mx
COORDINATOR_NAME=Coordinacion Academica
COORDINATOR_PASSWORD=replace-with-a-strong-password
