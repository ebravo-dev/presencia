DATABASE_URL=postgresql://usuario:password@postgres:5432/presencia_coordination?schema=public
DATABASE_MIGRATION_MAX_ATTEMPTS=10
DATABASE_MIGRATION_RETRY_MS=3000

COORDINATION_JWT_SECRET=reemplaza-con-un-secreto-de-al-menos-32-caracteres
INTERNAL_API_TOKEN=reemplaza-con-el-token-interno-compartido-de-al-menos-32-caracteres
COORDINATION_WEB_ORIGIN=https://coordinacion.example.edu.mx
COORDINATION_COOKIE_SECURE=true

PRESENCIA_DEBUG_MODE=false
PRESENCIA_DEBUG_CYCLE_ID=150
PRESENCIA_DEBUG_CYCLE_NAME="2026 - 1 PRIMAVERA"
PRESENCIA_DEBUG_EXTRA_PROFESSORS=4
PRESENCIA_DEBUG_VERBOSE_LOGS=true

ATTENDANCE_BACKEND_URL=http://backend:3000
ATTENDANCE_BACKEND_SERVICE_TOKEN=reemplaza-con-el-token-compartido-de-al-menos-32-caracteres

# Opcion sencilla para el primer coordinador.
COORDINATOR_EMAIL=coordinacion@uat.edu.mx
COORDINATOR_NAME=Coordinacion Academica
COORDINATOR_PASSWORD=

