ATTENDANCE_JOB_ENCRYPTION_SECRET=reemplaza-con-un-secreto-de-cifrado-unico-de-al-menos-32-caracteres

# Opcion sencilla para el primer coordinador.
COORDINATOR_EMAIL=coordinacion@uat.edu.mx
