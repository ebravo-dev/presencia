generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Professor {
  id                           String                 @id @default(cuid())
  institutionalEmail           String                 @unique @map("institutional_email")
  name                         String
  lastSyncPeriod               String?                @map("last_sync_period")
  createdAt                    DateTime               @default(now()) @map("created_at")
  updatedAt                    DateTime               @updatedAt @map("updated_at")
  attendanceRecords            AttendanceRecord[]
  groups                       Group[]
  syncJobs                     SyncJob[]
  primarySubstituteAssignments SubstituteAssignment[] @relation("PrimarySubstituteAssignments")
  substituteAssignments        SubstituteAssignment[] @relation("SubstituteAssignments")

  @@map("professors")
}

model Group {
  id                String             @id @default(cuid())
  code              String
  groupLetter       String             @default("") @map("group_letter")
  name              String
  level             String
  classroom         String
  schedule          Json
  period            String
  professorId       String             @map("professor_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  attendanceRecords AttendanceRecord[]
  professor         Professor          @relation(fields: [professorId], references: [id], onDelete: Cascade)
  students          Student[]
  substituteAssignments SubstituteAssignment[]

  @@unique([code, groupLetter, professorId, period])
  @@map("groups")
}

model SubstituteAssignment {
  id                    String    @id @default(cuid())
  groupId               String    @map("group_id")
  primaryProfessorId    String    @map("primary_professor_id")
  substituteProfessorId String    @map("substitute_professor_id")
  startsAt              DateTime? @map("starts_at")
  endsAt                DateTime? @map("ends_at")
  active                Boolean   @default(true)
  notes                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  group               Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  primaryProfessor    Professor @relation("PrimarySubstituteAssignments", fields: [primaryProfessorId], references: [id], onDelete: Cascade)
  substituteProfessor Professor @relation("SubstituteAssignments", fields: [substituteProfessorId], references: [id], onDelete: Cascade)

  @@unique([groupId, substituteProfessorId])
  @@index([primaryProfessorId])
  @@index([substituteProfessorId])
  @@map("substitute_assignments")
}

model Student {
  id          String       @id @default(cuid())
  matricula   String
  name        String
  beaconUuid  String?      @map("beacon_uuid")
  groupId     String       @map("group_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  attendances Attendance[]
  beaconDetections StudentBeaconDetection[]
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([matricula, groupId])
  @@index([beaconUuid])
  @@map("students")
}

model StudentDeviceBinding {
  id              String   @id @default(cuid())
  matricula       String   @unique
  attendanceUuid  String   @unique @map("attendance_uuid")
  deviceBindingId String?  @map("device_binding_id")
  platform        String?
  deviceInfo      String?  @map("device_info")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([attendanceUuid])
  @@map("student_device_bindings")
}

model AttendanceRecord {
  id          String       @id @default(cuid())
  date        DateTime     @db.Date
  groupId     String       @map("group_id")
  professorId String       @map("professor_id")
  professorEntryAt DateTime? @map("professor_entry_at")
  professorExitAt  DateTime? @map("professor_exit_at")
  roomBeaconUuid   String?   @map("room_beacon_uuid")
  roomBeaconRssi   Int?      @map("room_beacon_rssi")
  roomBeaconDistance Float?  @map("room_beacon_distance")
  roomBeaconAddress String?  @map("room_beacon_address")
  portalSyncStatus PortalSyncStatus @default(NOT_REQUESTED) @map("portal_sync_status")
  portalSyncError  String?          @map("portal_sync_error")
  portalSyncedAt   DateTime?        @map("portal_synced_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  professor   Professor    @relation(fields: [professorId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  studentBeaconDetections StudentBeaconDetection[]

  @@unique([date, groupId])
  @@map("attendance_records")
}

model Attendance {
  id                 String           @id @default(cuid())
  studentId          String           @map("student_id")
  attendanceRecordId String           @map("attendance_record_id")
  status             AttendanceStatus
  createdAt          DateTime         @default(now()) @map("created_at")
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  student            Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, attendanceRecordId])
  @@map("attendances")
}

model SyncJob {
  id           String     @id @default(cuid())
  professorId  String     @map("professor_id")
  status       SyncStatus @default(PENDING)
  totalGroups  Int?       @map("total_groups")
  currentGroup Int?       @map("current_group")
  currentGroupName String? @map("current_group_name")
  error        String?
  startedAt    DateTime   @default(now()) @map("started_at")
  completedAt  DateTime?  @map("completed_at")
  professor    Professor  @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@map("sync_jobs")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PortalSyncStatus {
  NOT_REQUESTED
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  PARTIAL
  FAILED
}

model StudentBleAttendance {
  id          String   @id @default(cuid())
  studentName String   @map("student_name")
  matricula   String
  beaconId    String   @map("beacon_id")
  detectedAt  DateTime @map("detected_at")
  deviceInfo  String?  @map("device_info")
  syncedAt    DateTime @default(now()) @map("synced_at")

  @@map("student_ble_attendances")
}

model StudentBeaconDetection {
  id                 String           @id @default(cuid())
  studentId          String           @map("student_id")
  attendanceRecordId String           @map("attendance_record_id")
  beaconUuid         String           @map("beacon_uuid")
  detectedAt         DateTime         @map("detected_at")
  rssi               Int?
  distance           Float?
  txPower            Int?             @map("tx_power")
  bluetoothAddress   String?          @map("bluetooth_address")
  createdAt          DateTime         @default(now()) @map("created_at")
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  student            Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, attendanceRecordId])
  @@index([beaconUuid])
  @@map("student_beacon_detections")
}

model Beacon {
  id        String   @id @default(cuid())
  uuid      String   @unique
  classroom String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("beacons")
}

model SystemSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
