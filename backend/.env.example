# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/asistenciamas"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
SUPER_USER_PASSWORD="development-super-user-password"

# RSA Private Key (for decrypting passwords from Flutter app)
# Generate with: openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:4096
# Then base64 encode: base64 -i private.pem | tr -d '\n'
RSA_PRIVATE_KEY="base64-encoded-private-key"

# Server
PORT=3000
NODE_ENV="development"
APP_TIME_ZONE="America/Mexico_City"
DEBUG_EXTRA_CLASS_HOURS=4

# UAT Portal (for reference, not stored)
UAT_PORTAL_URL="https://administracionescolar.uat.edu.mx"
UAT_ID_CICLO_ESCOLAR=150
UAT_ID_DES=12

# Internal backend-apirest service consumed by this backend
BACKEND_API_REST_URL="http://localhost:3100"

# Shared only with backend-apirest. Generate at least 32 random characters.
INTERNAL_API_TOKEN="development-internal-service-token-change-me"
