# App
APP_PORT=3000
NODE_ENV=production
JWT_EXPIRES_IN=7d
UAT_PORTAL_URL=https://administracionescolar.uat.edu.mx

# Create PostgreSQL and Redis separately in Dokploy and paste their internal URLs here.
DATABASE_URL=postgresql://user:password@postgres-host:5432/presencia?schema=public
REDIS_URL=redis://redis-host:6379
BACKEND_API_REST_URL=http://backend-apirest:3100

# Generate a long random value, at least 32 characters.
JWT_SECRET=change-me-with-a-long-random-secret
SUPER_USER_PASSWORD=change-me-with-a-unique-admin-password
CORS_ALLOWED_ORIGINS=https://presencia.example.edu.mx

# Must be the same unique token configured in backend-apirest.
INTERNAL_API_TOKEN=change-me-with-a-long-unique-internal-token

# Generate with:
# openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:4096
# base64 -w 0 private.pem
RSA_PRIVATE_KEY=base64-encoded-private-key
