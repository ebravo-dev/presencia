server {
  listen 8080;
  server_name _;
  absolute_redirect off;
  port_in_redirect off;
  server_name_in_redirect off;
  root /usr/share/nginx/html;

  location = / {
    return 302 /coordinacion/;
  }

  location = /coordinacion {
    return 308 /coordinacion/;
  }

  location /coordinacion/ {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
    try_files $uri $uri/ /coordinacion/index.html;
  }

  location /coordinacion/assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  location = /coordinacion/frontend-version.json {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
    try_files $uri =404;
  }

  location /api/ {
    proxy_pass http://${BACKEND_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 10s;
    proxy_read_timeout 60s;
  }

  location = /frontend-health {
    access_log off;
    default_type application/json;
    return 200 '{"status":"ok","service":"frontend-coord"}';
  }

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
}
